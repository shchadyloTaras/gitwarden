---
import { copy } from '../content/copy'
import { LIVE_DEMO_PROFILES } from '../lib/liveDemo'
import LiveDemoIcon from './LiveDemoIcon.astro'

const demo = copy.liveDemo
const issues = [demo.issues.profileMismatch, demo.issues.nameMismatch, demo.issues.emailMismatch]
const profileLabels = {
  Personal: demo.controls.personalProfile,
  Work: demo.controls.workProfile,
  Client: demo.controls.clientProfile,
}
type DemoNavIcon =
  | 'profiles'
  | 'repositories'
  | 'status'
  | 'commit'
  | 'remote'
  | 'branches'
  | 'history'
  | 'safety-center'
  | 'settings'

interface DemoNavItem {
  icon: DemoNavIcon
  label: string
  selected?: boolean
}

const navGroups: Array<{ label: string; items: DemoNavItem[] }> = [
  {
    label: demo.window.navigation.manageGroup,
    items: [
      { icon: 'profiles', label: demo.window.navigation.profiles },
      { icon: 'repositories', label: demo.window.navigation.repositories },
    ],
  },
  {
    label: demo.window.navigation.gitGroup,
    items: [
      { icon: 'status', label: demo.window.navigation.status },
      { icon: 'commit', label: demo.window.navigation.commit, selected: true },
      { icon: 'remote', label: demo.window.navigation.remote },
      { icon: 'branches', label: demo.window.navigation.branches },
      { icon: 'history', label: demo.window.navigation.history },
      { icon: 'safety-center', label: demo.window.navigation.safetyCenter },
    ],
  },
  {
    label: demo.window.navigation.appGroup,
    items: [{ icon: 'settings', label: demo.window.navigation.settings }],
  },
]
---

<section
  id="live-demo"
  class="live-demo"
  data-testid="live-demo"
  data-live-demo
  data-profile="Personal"
  data-guard="blocked"
  data-outcome="idle"
  aria-labelledby="live-demo-heading"
>
  <div class="live-demo-intro" data-reveal>
    <p class="live-demo-eyebrow">{demo.section.eyebrow}</p>
    <h2 id="live-demo-heading">{demo.section.heading}</h2>
    <p class="live-demo-subhead">{demo.section.subhead}</p>
  </div>

  <div class="live-demo-controls" data-testid="live-demo-controls" data-reveal>
    <fieldset class="live-demo-profile-picker">
      <legend>{demo.controls.profileGroupLabel}</legend>
      <div class="live-demo-profile-options">
        {
          LIVE_DEMO_PROFILES.map((profile) => (
            <label>
              <input
                type="radio"
                name="live-demo-profile"
                value={profile}
                checked={profile === 'Personal'}
                data-live-profile
              />
              <span>{profileLabels[profile]}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <div class="live-demo-scenario-note">
      <span>{demo.controls.scenarioLabel}</span>
      <strong>{demo.scenario.assignedProfile}</strong>
      <small>{demo.controls.scenarioHint}</small>
    </div>

    <button
      type="button"
      class="live-demo-reset"
      data-live-action="reset"
      data-testid="live-demo-reset"
    >
      {demo.controls.reset}
    </button>
  </div>

  <div class="live-demo-window" data-testid="live-demo-window" data-reveal>
    <div class="live-demo-titlebar" data-testid="live-demo-titlebar">
      <span class="live-demo-sidebar-toggle" aria-hidden="true">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </span>
    </div>

    <header class="live-demo-app-header" data-testid="live-demo-app-header">
      <span class="live-demo-brand">
        <svg
          class="live-demo-brand-mark"
          width="22"
          height="22"
          viewBox="0 0 512 512"
          aria-hidden="true"
        >
          <defs>
            <linearGradient id="live-demo-shield-gradient" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#818cf8"></stop>
              <stop offset="0.55" stop-color="#6366f1"></stop>
              <stop offset="1" stop-color="#3b82f6"></stop>
            </linearGradient>
          </defs>
          <path
            d="M256 44 C338 78 388 86 424 90 L424 250 C424 356 354 432 256 472 C158 432 88 356 88 250 L88 90 C124 86 174 78 256 44 Z"
            fill="url(#live-demo-shield-gradient)"></path>
          <path
            d="M304 232 C304 300 212 270 212 306"
            fill="none"
            stroke="#fff"
            stroke-width="24"
            stroke-linecap="round"></path>
          <line
            x1="212"
            y1="190"
            x2="212"
            y2="352"
            stroke="#fff"
            stroke-width="26"
            stroke-linecap="round"></line>
          <circle cx="212" cy="190" r="30" fill="#fff"></circle>
          <circle cx="212" cy="352" r="30" fill="#fff"></circle>
          <circle cx="304" cy="206" r="30" fill="#fff"></circle>
          <circle cx="212" cy="190" r="13" fill="#4f46e5"></circle>
          <circle cx="212" cy="352" r="13" fill="#3b82f6"></circle>
          <circle cx="304" cy="206" r="13" fill="#6366f1"></circle>
        </svg>
        <span>{demo.window.appName}</span>
      </span>
      <span class="live-demo-divider" aria-hidden="true"></span>
      <span class="live-demo-header-picker live-demo-header-repo">
        <span>{demo.scenario.repository}</span>
        <svg viewBox="0 0 12 12" aria-hidden="true">
          <path d="m3.25 4.75 2.75 2.5 2.75-2.5"></path>
        </svg>
      </span>
      <span class="live-demo-header-checked">{demo.window.checkedOut}</span>
      <span class="live-demo-header-picker live-demo-branch">
        <code>{demo.scenario.branch}</code>
        <svg viewBox="0 0 12 12" aria-hidden="true">
          <path d="m3.25 4.75 2.75 2.5 2.75-2.5"></path>
        </svg>
      </span>
      <span class="live-demo-header-spacer"></span>
      <span
        class="live-demo-guard live-demo-guard--blocked"
        data-live-guard
        data-testid="live-demo-guard"
      >
        {demo.status.guardBlocked}
      </span>
      <span class="live-demo-divider live-demo-divider--profile" aria-hidden="true"></span>
      <span class="live-demo-active-profile">
        <span class="live-demo-profile-dot" aria-hidden="true"></span>
        <span data-live-active-profile data-testid="live-demo-active-profile">
          {demo.controls.personalProfile}
        </span>
      </span>
      <span class="live-demo-header-action" aria-hidden="true">{demo.window.aiButton}</span>
      <span class="live-demo-header-action" aria-hidden="true">{demo.window.infoButton}</span>
    </header>

    <div class="live-demo-shell">
      <nav
        class="live-demo-sidebar"
        data-testid="live-demo-sidebar"
        aria-label={demo.window.navigationLabel}
      >
        {
          navGroups.map((group) => (
            <div class="live-demo-nav-group">
              <span class="live-demo-nav-group-label">{group.label}</span>
              {group.items.map((item) => (
                <span class:list={['live-demo-nav-item', { 'is-selected': item.selected }]}>
                  <span class="live-demo-nav-icon" aria-hidden="true">
                    <LiveDemoIcon name={item.icon} />
                  </span>
                  <span data-live-nav-label>{item.label}</span>
                </span>
              ))}
            </div>
          ))
        }
      </nav>

      <main class="live-demo-main" data-testid="live-demo-commit-screen">
        <h3>{demo.window.navigation.commit}</h3>

        <div class="live-demo-staged">
          <span class="live-demo-panel-label">{demo.window.stagedHeading}</span>
          <div class="live-demo-file-row">
            <span class="live-demo-file-status" aria-hidden="true">M</span>
            <code>{demo.scenario.stagedFile}</code>
          </div>
        </div>

        <label class="live-demo-message">
          <span>{demo.window.messageLabel}</span>
          <textarea readonly rows="7">{demo.scenario.commitMessage}</textarea>
        </label>

        <div
          class="live-demo-alert"
          data-live-alert
          data-testid="live-demo-alert"
          aria-labelledby="live-demo-blocked-heading"
          hidden
        >
          <strong id="live-demo-blocked-heading" class="sr-only"
            >{demo.window.blockedHeading}</strong
          >
          <div class="live-demo-issues">
            {
              issues.map((issue) => (
                <div class="live-demo-issue" data-testid="live-demo-issue">
                  <span class="live-demo-issue-icon" aria-hidden="true">
                    <svg viewBox="0 0 16 16">
                      <circle cx="8" cy="8" r="6.25" />
                      <path d="M8 4.75v3.9M8 11.15v.1" />
                    </svg>
                  </span>
                  <span>{issue}</span>
                </div>
              ))
            }
          </div>
          <div class="live-demo-remediation">
            <button
              type="button"
              class="live-demo-fix"
              data-live-action="fix"
              data-pending-label={demo.controls.fixing}
              data-testid="live-demo-fix"
            >
              {demo.controls.quickFix}
            </button>
          </div>
        </div>

        <div
          class="live-demo-completion"
          data-live-completion
          data-testid="live-demo-completion"
          role="status"
          hidden
        >
          <strong>{demo.completion.heading}</strong>
          <span>{demo.completion.body}</span>
        </div>

        <div class="live-demo-actions">
          <button
            type="button"
            class="live-demo-commit"
            data-live-action="commit"
            data-testid="live-demo-commit"
          >
            {demo.controls.commit}
          </button>
        </div>
      </main>

      <aside class="live-demo-context-panel" data-testid="live-demo-context-panel">
        <div class="live-demo-context-tabs" role="tablist">
          <span role="tab" aria-selected="true">{demo.window.contextTab}</span>
          <span role="tab" aria-selected="false">{demo.window.aiChatTab}</span>
        </div>
        <div class="live-demo-inspector">
          <strong class="live-demo-inspector-heading">{demo.window.contextHeading}</strong>

          <div class="live-demo-inspector-section">
            <strong>{demo.window.profileLabel}</strong>
            <div class="live-demo-inspector-profile">
              <span class="live-demo-profile-dot" aria-hidden="true"></span>
              <span data-live-inspector-profile>{demo.controls.personalProfile}</span>
            </div>
            <dl>
              <div>
                <dt>{demo.window.nameLabel}</dt>
                <dd data-live-inspector-name>{demo.profiles.Personal.name}</dd>
              </div>
              <div>
                <dt>{demo.window.emailLabel}</dt>
                <dd data-live-inspector-email>{demo.profiles.Personal.email}</dd>
              </div>
            </dl>
          </div>

          <div class="live-demo-inspector-section">
            <strong>{demo.window.repositoryLabel}</strong>
            <code>{demo.scenario.repository}</code>
          </div>

          <div class="live-demo-inspector-section">
            <strong>{demo.window.branchLabel}</strong>
            <code>{demo.scenario.branch}</code>
          </div>

          <div class="live-demo-inspector-section">
            <strong>{demo.window.guardLabel}</strong>
            <span class="live-demo-inspector-guard" data-live-inspector-guard>
              {demo.status.inspectorBlocked}
            </span>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <p class="live-demo-announcement sr-only" data-live-announcement aria-live="polite"></p>
  <noscript>
    <p class="live-demo-noscript" data-testid="live-demo-noscript">{demo.noScript}</p>
  </noscript>
</section>

<script>
  import { copy } from '../content/copy'
  import {
    LIVE_DEMO_INITIAL_STATE,
    deriveLiveDemoView,
    reduceLiveDemo,
    type LiveDemoProfile,
    type LiveDemoState,
  } from '../lib/liveDemo'

  const demoCopy = copy.liveDemo
  const profileAnnouncements: Record<LiveDemoProfile, string> = {
    Personal: demoCopy.accessibility.personalSelected,
    Work: demoCopy.accessibility.workSelected,
    Client: demoCopy.accessibility.clientSelected,
  }

  document.querySelectorAll<HTMLElement>('[data-live-demo]').forEach((root) => {
    if (root.dataset.enhanced === 'true') return
    root.dataset.enhanced = 'true'

    let state: LiveDemoState = { ...LIVE_DEMO_INITIAL_STATE }
    const guard = root.querySelector<HTMLElement>('[data-live-guard]')
    const activeProfile = root.querySelector<HTMLElement>('[data-live-active-profile]')
    const inspectorProfile = root.querySelector<HTMLElement>('[data-live-inspector-profile]')
    const inspectorName = root.querySelector<HTMLElement>('[data-live-inspector-name]')
    const inspectorEmail = root.querySelector<HTMLElement>('[data-live-inspector-email]')
    const inspectorGuard = root.querySelector<HTMLElement>('[data-live-inspector-guard]')
    const alert = root.querySelector<HTMLElement>('[data-live-alert]')
    const completion = root.querySelector<HTMLElement>('[data-live-completion]')
    const announcement = root.querySelector<HTMLElement>('[data-live-announcement]')
    const commit = root.querySelector<HTMLButtonElement>('[data-live-action="commit"]')
    const profileInputs = Array.from(root.querySelectorAll<HTMLInputElement>('[data-live-profile]'))

    function announce(message: string): void {
      if (announcement) announcement.textContent = message
    }

    function render(message?: string): void {
      const view = deriveLiveDemoView(state)
      const identity = demoCopy.profiles[state.activeProfile]
      root.dataset.profile = state.activeProfile
      root.dataset.guard = view.guard
      root.dataset.outcome = state.outcome

      if (guard) {
        guard.textContent =
          view.guard === 'ready' ? demoCopy.status.guardReady : demoCopy.status.guardBlocked
        guard.classList.toggle('live-demo-guard--ready', view.guard === 'ready')
        guard.classList.toggle('live-demo-guard--blocked', view.guard === 'blocked')
      }
      if (activeProfile) activeProfile.textContent = state.activeProfile
      if (inspectorProfile) inspectorProfile.textContent = state.activeProfile
      if (inspectorName) inspectorName.textContent = identity.name
      if (inspectorEmail) inspectorEmail.textContent = identity.email
      if (inspectorGuard) {
        inspectorGuard.textContent =
          view.guard === 'ready' ? demoCopy.status.inspectorReady : demoCopy.status.inspectorBlocked
        inspectorGuard.dataset.state = view.guard
      }
      profileInputs.forEach((input) => {
        input.checked = input.value === state.activeProfile
      })

      if (alert) {
        alert.hidden = !view.issuesVisible
        if (view.issuesVisible) alert.setAttribute('role', 'alert')
        else alert.removeAttribute('role')
      }
      if (completion) completion.hidden = state.outcome !== 'complete'
      if (commit) commit.disabled = state.outcome === 'blocked' || state.outcome === 'complete'
      if (message) announce(message)
    }

    root.addEventListener('change', (event) => {
      const input = (event.target as Element | null)?.closest<HTMLInputElement>(
        '[data-live-profile]'
      )
      if (!input || !root.contains(input)) return
      const profile = input.value as LiveDemoProfile
      state = reduceLiveDemo(state, { type: 'select-profile', profile })
      render(profileAnnouncements[profile])
    })

    root.addEventListener('click', (event) => {
      const button = (event.target as Element | null)?.closest<HTMLButtonElement>(
        '[data-live-action]'
      )
      if (!button || !root.contains(button)) return

      switch (button.dataset.liveAction) {
        case 'commit':
          state = reduceLiveDemo(state, { type: 'attempt-commit' })
          render(
            state.outcome === 'complete'
              ? demoCopy.completion.announcement
              : demoCopy.accessibility.blockersRevealed
          )
          break
        case 'fix':
          state = reduceLiveDemo(state, { type: 'apply-profile-fix' })
          render(demoCopy.accessibility.clientSelected)
          commit?.focus()
          break
        case 'reset': {
          state = reduceLiveDemo(state, { type: 'reset' })
          render(demoCopy.accessibility.resetComplete)
          const personal = profileInputs.find((input) => input.value === 'Personal')
          personal?.focus()
          break
        }
      }
    })

    render()
  })
</script>
